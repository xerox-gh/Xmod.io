{
  "name": "xmod-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An original procedural physics playground for the browser",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:pages": "vite build --mode pages --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node server/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:pages": "node scripts/pages-smoke.mjs",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "express": "5.3.0",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2",
    "vite": "8.3.5"
  }
}
